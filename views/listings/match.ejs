<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-4">
  <div class="col-lg-10 offset-lg-1">
    <div class="p-4 p-md-5 mb-4 rounded-4" style="background:#fff3f3;">
      <p class="text-uppercase text-muted mb-2">WanderStay feature</p>
      <h1 class="display-6 fw-bold">WanderMatch</h1>
      <p class="lead mb-0">Tell us what matters for your stay. We'll rank properties using your budget, purpose, and preferred amenities — and explain why each one matches.</p>
    </div>

    <form method="get" action="/listings/match" class="card card-body mb-4">
      <div class="row g-3">
        <div class="col-md-4">
          <label for="budget" class="form-label">Maximum budget per night (₹)</label>
          <input type="number" min="1" id="budget" name="budget" class="form-control" value="<%= budget %>" placeholder="e.g. 1500">
        </div>
        <div class="col-md-4">
          <label for="purpose" class="form-label">Purpose of stay</label>
          <select id="purpose" name="purpose" class="form-select">
            <option value="">Any purpose</option>
            <% ["Student", "Work", "Family", "Short stay"].forEach(function(p) { %>
              <option value="<%= p %>" <%= purpose === p ? "selected" : "" %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Important amenities</label>
          <% ["Wi-Fi", "Kitchen", "Workspace", "Laundry", "Parking", "Public transport nearby"].forEach(function(a) { %>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="amenities" value="<%= a %>" id="match-<%= a.replace(/\s/g, '-') %>" <%= selectedAmenities.includes(a) ? "checked" : "" %>>
              <label class="form-check-label" for="match-<%= a.replace(/\s/g, '-') %>"><%= a %></label>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-dark" type="submit">Find my match</button>
        <a class="btn btn-outline-secondary" href="/listings/match">Reset</a>
      </div>
      <small class="text-muted mt-3">Match scores are calculated from the details hosts provide. They are a guide, not a guarantee of quality or availability.</small>
    </form>

    <% if (hasSearched) { %>
      <h2 class="h4 mb-3">Your best matches</h2>
      <% if (listings.length === 0) { %>
        <p>No listings are available yet. Try again after a host adds a property.</p>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
          <% listings.forEach(function(result) { const listing = result.listing; %>
            <div class="col">
              <div class="card h-100 shadow-sm">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" class="card-img-top" alt="Property image" style="height:220px;object-fit:cover;">
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <h3 class="h5"><%= listing.title %></h3>
                    <span class="badge text-bg-dark"><%= result.score %>% match</span>
                  </div>
                  <p class="mb-2"><strong>₹<%= Number(listing.price || 0).toLocaleString("en-IN") %></strong> / night</p>
                  <p class="text-muted mb-2"><%= listing.location %>, <%= listing.country %></p>
                  <% if (result.reasons.length) { %>
                    <p class="small fw-semibold mb-1">Why it matched</p>
                    <ul class="small">
                      <% result.reasons.forEach(function(reason) { %><li><%= reason %></li><% }) %>
                    </ul>
                  <% } else { %>
                    <p class="small text-muted">This property has limited matching details. Check with the host before deciding.</p>
                  <% } %>
                  <a class="btn btn-outline-dark btn-sm" href="/listings/<%= listing._id %>">View property</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
